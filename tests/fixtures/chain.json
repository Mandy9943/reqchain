{
  "schemaVersion": 1,
  "id": "chain",
  "name": "Chain",
  "baseUrl": "BASE_URL",
  "variables": {},
  "environments": [
    {
      "name": "test",
      "variables": {
        "documento": "12345678"
      }
    }
  ],
  "auth": {
    "type": "none"
  },
  "endpoints": [
    {
      "id": "token",
      "name": "Token",
      "method": "POST",
      "path": "/token",
      "headers": {},
      "query": {},
      "variables": {},
      "auth": {
        "type": "basic",
        "username": "{{secret:GW_USER}}",
        "password": "{{secret:GW_PASS}}"
      },
      "body": {
        "type": "form",
        "fields": {
          "grant_type": "client_credentials"
        }
      }
    },
    {
      "id": "business",
      "name": "Business",
      "method": "POST",
      "path": "/business",
      "headers": {},
      "query": {},
      "variables": {},
      "auth": {
        "type": "chained",
        "source": {
          "endpoint": "token"
        },
        "extract": {
          "from": "body",
          "jsonPath": "$.access_token"
        },
        "ttl": {
          "from": "body",
          "jsonPath": "$.expires_in",
          "unit": "seconds"
        },
        "inject": {
          "into": "header",
          "name": "Authorization",
          "template": "Bearer {{value}}"
        },
        "retryOn": [
          401,
          403
        ]
      },
      "body": {
        "type": "json",
        "content": {
          "doc": "{{documento}}"
        }
      }
    },
    {
      "id": "header-business",
      "name": "Header business",
      "method": "GET",
      "path": "/header-business",
      "headers": {},
      "query": {},
      "variables": {},
      "auth": {
        "type": "chained",
        "source": {
          "endpoint": "token"
        },
        "extract": {
          "from": "header",
          "name": "x-token"
        },
        "inject": {
          "into": "header",
          "name": "Authorization",
          "template": "Bearer {{value}}"
        }
      }
    },
    {
      "id": "query-business",
      "name": "Query business",
      "method": "GET",
      "path": "/query-business",
      "headers": {},
      "query": {},
      "variables": {},
      "auth": {
        "type": "chained",
        "source": {
          "endpoint": "token"
        },
        "extract": {
          "from": "body",
          "jsonPath": "$.access_token"
        },
        "inject": {
          "into": "query",
          "name": "access_token"
        }
      }
    },
    {
      "id": "body-business",
      "name": "Body business",
      "method": "POST",
      "path": "/body-business",
      "headers": {},
      "query": {},
      "variables": {},
      "auth": {
        "type": "chained",
        "source": {
          "endpoint": "token"
        },
        "extract": {
          "from": "body",
          "jsonPath": "$.access_token"
        },
        "inject": {
          "into": "body",
          "pointer": "/token",
          "template": "{{value}}"
        }
      },
      "body": {
        "type": "json",
        "content": {
          "doc": "{{documento}}",
          "token": ""
        }
      }
    },
    {
      "id": "bad-pointer-business",
      "name": "Bad pointer business",
      "method": "POST",
      "path": "/bad-pointer-business",
      "headers": {},
      "query": {},
      "variables": {},
      "auth": {
        "type": "chained",
        "source": {
          "endpoint": "token"
        },
        "extract": {
          "from": "body",
          "jsonPath": "$.access_token"
        },
        "inject": {
          "into": "body",
          "pointer": "/nope/deep"
        }
      },
      "body": {
        "type": "json",
        "content": {
          "doc": "{{documento}}"
        }
      }
    },
    {
      "id": "token-noexp",
      "name": "Token without expiry",
      "method": "POST",
      "path": "/token-noexp",
      "headers": {},
      "query": {},
      "variables": {},
      "auth": {
        "type": "none"
      }
    },
    {
      "id": "noexp-business",
      "name": "No expiry business",
      "method": "GET",
      "path": "/noexp-business",
      "headers": {},
      "query": {},
      "variables": {},
      "auth": {
        "type": "chained",
        "source": {
          "endpoint": "token-noexp"
        },
        "extract": {
          "from": "body",
          "jsonPath": "$.access_token"
        },
        "inject": {
          "into": "header",
          "name": "Authorization",
          "template": "Bearer {{value}}"
        }
      }
    },
    {
      "id": "token-fail",
      "name": "Failing token",
      "method": "POST",
      "path": "/token-fail",
      "headers": {},
      "query": {},
      "variables": {},
      "auth": {
        "type": "none"
      }
    },
    {
      "id": "fail-business",
      "name": "Fail business",
      "method": "GET",
      "path": "/fail-business",
      "headers": {},
      "query": {},
      "variables": {},
      "auth": {
        "type": "chained",
        "source": {
          "endpoint": "token-fail"
        },
        "extract": {
          "from": "body",
          "jsonPath": "$.access_token"
        },
        "inject": {
          "into": "header",
          "name": "Authorization",
          "template": "Bearer {{value}}"
        }
      }
    },
    {
      "id": "xpath-business",
      "name": "Xpath business",
      "method": "GET",
      "path": "/xpath-business",
      "headers": {},
      "query": {},
      "variables": {},
      "auth": {
        "type": "chained",
        "source": {
          "endpoint": "token"
        },
        "extract": {
          "from": "body",
          "xpath": "//token"
        },
        "inject": {
          "into": "header",
          "name": "Authorization",
          "template": "Bearer {{value}}"
        }
      }
    }
  ]
}
