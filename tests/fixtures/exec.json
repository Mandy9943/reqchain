{
  "schemaVersion": 1,
  "id": "exec",
  "name": "Exec",
  "baseUrl": "BASE_URL",
  "variables": {},
  "environments": [
    {
      "name": "test",
      "variables": {
        "documento": "12345678"
      }
    }
  ],
  "auth": {
    "type": "none"
  },
  "endpoints": [
    {
      "id": "echo",
      "name": "Echo",
      "method": "POST",
      "path": "/echo/1.0",
      "headers": {
        "x-doc": "{{documento}}"
      },
      "query": {
        "trace": "on"
      },
      "variables": {},
      "auth": {
        "type": "none"
      },
      "body": {
        "type": "json",
        "content": {
          "doc": "{{documento}}"
        }
      }
    },
    {
      "id": "odilo",
      "name": "Odilo user",
      "method": "GET",
      "path": "/odilo/user",
      "headers": {
        "token": "{{secret:API_TOKEN}}",
        "user": "{{documento}}"
      },
      "query": {},
      "variables": {},
      "auth": {
        "type": "computed",
        "name": "hash",
        "expression": "md5(now(\"YYYYMMDD\") + {{documento}})"
      }
    }
  ]
}
