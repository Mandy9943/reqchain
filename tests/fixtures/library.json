{
  "schemaVersion": 1,
  "id": "library",
  "name": "Library (test)",
  "baseUrl": "https://api.example.com",
  "variables": {},
  "environments": [
    {
      "name": "test",
      "variables": {
        "person_id": "12345678"
      }
    }
  ],
  "auth": {
    "type": "none"
  },
  "endpoints": [
    {
      "id": "library-user",
      "name": "Library User",
      "method": "GET",
      "path": "/library/user",
      "headers": {
        "token": "{{secret:API_TOKEN}}",
        "user": "{{person_id}}"
      },
      "query": {},
      "variables": {},
      "auth": {
        "type": "computed",
        "name": "hash",
        "expression": "md5(now(\"YYYYMMDD\") + {{person_id}})"
      }
    }
  ]
}
